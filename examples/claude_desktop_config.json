{
  "mcpServers": {
    "elemm-gateway": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-v",
        "elemm-config:/root/.elemm",
        "ghcr.io/v3rm1ll1on/elemm:latest",
        "elemm-gateway",
        "--transport",
        "stdio"
      ]
    }
  }
}